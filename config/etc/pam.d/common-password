# /etc/pam.d/common-password (password lines only, default comments removed)
# pam_pwquality enforces the rules in /etc/security/pwquality.conf,
# pam_pwhistory blocks reuse of the last 5 passwords, pam_unix hashes with yescrypt.

password    requisite                   pam_pwquality.so retry=3
password    required                    pam_pwhistory.so remember=5 use_authtok
password    [success=1 default=ignore]  pam_unix.so obscure use_authtok try_first_pass yescrypt
password    requisite                   pam_deny.so
password    required                    pam_permit.so
