# /etc/pam.d/common-auth (auth lines only, default comments removed)
# pam_faillock locks an account for 15 minutes (900 s) after 5 failed attempts.
# fail_interval was left at its default of 900 s (15 minutes).

auth    required                        pam_faillock.so preauth silent deny=5 unlock_time=900
auth    [success=1 default=bad]         pam_unix.so nullok
auth    [default=die]                   pam_faillock.so authfail deny=5 unlock_time=900
auth    sufficient                      pam_faillock.so authsucc deny=5 unlock_time=900
auth    requisite                       pam_deny.so
auth    required                        pam_permit.so
auth    optional                        pam_cap.so
